# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── LLM Providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── UPI / PSP Credentials ─────────────────────────────────────────────────────
UPI_CLIENT_ID=your-client-id
UPI_CLIENT_SECRET=your-client-secret
UPI_MERCHANT_ID=your-merchant-id

# ── Database ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgres://user:password@localhost:5432/sentinel?sslmode=disable

# ── Safety ────────────────────────────────────────────────────────────────────
TRANSACTION_THRESHOLD_INR=500

# ── App ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
MAX_WORKERS=4
LOG_LEVEL=info
